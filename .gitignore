# uploaded attachments (files are filed where they belong, e.g. refs/)
attachments/

# downloaded reference PDFs (re-downloadable; cited by name in reports/)
refs/*.pdf

# agent scratch space: literature downloads, build intermediates
.scratch/

# compiled report output (regenerate from reports/*.md with scripts/build-report-tex.py)
reports/*.pdf

# LaTeX build artifacts from that compilation
reports/*.aux
reports/*.log
reports/*.toc

# python bytecode
__pycache__/
*.pyc

# swarm working directories (huge; the parts worth keeping are copied to certificate/ and data/)
.ultramath/

# LaTeX/build intermediates from scripts/build-report-tex.py
build/
